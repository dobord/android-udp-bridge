# UDP Bridge Server Environment Configuration

# Target UDP server settings
TARGET_UDP_HOST=127.0.0.1
TARGET_UDP_PORT=5060

# Bridge server settings
BRIDGE_TCP_PORT=8080
CLIENT_TIMEOUT=300
MAX_CLIENTS=1000
LOG_LEVEL=INFO

# SSH settings
SSH_USER=sshuser
SSH_PASSWORD=sshpassword

# Docker settings
COMPOSE_PROJECT_NAME=udp-bridge
