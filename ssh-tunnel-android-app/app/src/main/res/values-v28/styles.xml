<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 28+ typography lineHeight overrides -->
    <style name="TitleTextStyle">
        <item name="android:textColor">@color/pale_gray</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:lineHeight">40sp</item>
    </style>
    <style name="HeadingTextStyle">
        <item name="android:textColor">@color/pale_gray</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">28sp</item>
    </style>
    <style name="BodyTextStyle">
        <item name="android:textColor">@color/pale_gray</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="CaptionTextStyle">
        <item name="android:textColor">@color/muted_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    <style name="StatusTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/status_background</item>
    </style>
</resources>
