<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Disconnected"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#f0f0f0"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SSH Connection Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/host_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SSH Server Host"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SSH Server Port (22)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/username_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authentication Method"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/auth_method_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/password_auth_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:checked="true"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/key_auth_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Key" />

        </RadioGroup>

        <EditText
            android:id="@+id/password_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/private_key_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Private Key Path"
            android:inputType="text"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/passphrase_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key Passphrase (optional)"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/connect_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/disconnect_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnect"
                android:layout_marginStart="8dp"
                android:enabled="false" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UDP Port Forwarding"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/local_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local UDP Port"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/remote_host_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remote Host (127.0.0.1)"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/remote_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remote UDP Port"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/start_forwarding_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_forwarding_button"
            android:enabled="false" />

        <!-- UDP Bridge Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#cccccc"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UDP Bridge Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bridge_enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable UDP Bridge"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/bridge_host_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge Server Host"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/bridge_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge Server Port (8080)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/bridge_local_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge Local UDP Port (5060)"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/auto_reconnect_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Reconnect"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/connection_timeout_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Connection Timeout (seconds)"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/bridge_start_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Bridge"
                android:layout_marginEnd="4dp"
                android:enabled="false" />

            <Button
                android:id="@+id/bridge_stop_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop Bridge"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:enabled="false" />

            <Button
                android:id="@+id/bridge_config_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/bridge_status_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bridge Status: Disconnected"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:background="#f0f0f0"
            android:padding="8dp" />

        <TextView
            android:id="@+id/bridge_stats_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statistics: N/A"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:background="#f8f8f8"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: UDP Bridge creates a direct protocol connection to bridge server for improved performance and client management."
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:background="#e8f5e8"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>