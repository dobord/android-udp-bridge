<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UDP Bridge Configuration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/config_bridge_enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable UDP Bridge"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/config_bridge_host_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge Server Host"
            android:inputType="text"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/config_bridge_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge Server Port"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/config_local_port_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local UDP Port"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/config_auto_reconnect_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Reconnect"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/config_connection_timeout_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Connection Timeout (seconds)"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/config_save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Settings"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/config_reset_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset to Defaults"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration Help"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Bridge Server Host: IP address or hostname of the UDP bridge server\n• Bridge Server Port: TCP port where bridge server listens (usually 8080)\n• Local UDP Port: Local port where Android app will listen for UDP packets\n• Auto Reconnect: Automatically reconnect if connection is lost"
            android:textSize="12sp"
            android:background="#f8f8f8"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
